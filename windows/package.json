{
  "name": "campushub",
  "productName": "キャンパスハブ",
  "version": "0.3.6",
  "description": "湘南工科大学の Moodle・Campus Square・大学メールを1つにまとめるアプリ（Windows版）",
  "author": "キャンパスハブ",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "local.campushub.app",
    "productName": "キャンパスハブ",
    "copyright": "キャンパスハブ",
    "directories": {
      "output": "../dist/windows",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Sources/CampusHub/Resources/Appearance",
        "to": "Appearance",
        "filter": [
          "*.jpg"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "CampusHub-Setup-${version}.${ext}",
      "executableName": "CampusHub"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "キャンパスハブ",
      "uninstallDisplayName": "キャンパスハブ",
      "installerLanguages": [
        "ja_JP"
      ],
      "language": "1041",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lis-louis",
        "repo": "shonanschool-status",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lis-louis/shonanschool-status.git"
  }
}
