{
  "name": "campushub",
  "productName": "キャンパスハブ",
  "version": "0.2.0",
  "description": "湘南工科大学の Moodle・Campus Square・大学メールを1つにまとめるアプリ（Windows版）",
  "author": "キャンパスハブ",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never && node -e \"const v=require('./package.json').version,f='CampusHub-Setup-'+v+'.exe';require('fs').copyFileSync('../dist/windows/'+f,'../'+f);console.log('作成しました: '+f)\""
  },
  "build": {
    "appId": "local.campushub.app",
    "productName": "キャンパスハブ",
    "copyright": "キャンパスハブ",
    "directories": {
      "output": "../dist/windows",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Sources/CampusHub/Resources/Appearance",
        "to": "Appearance",
        "filter": [
          "*.jpg"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "CampusHub-Setup-${version}.${ext}",
      "executableName": "CampusHub"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "キャンパスハブ",
      "uninstallDisplayName": "キャンパスハブ",
      "installerLanguages": [
        "ja_JP"
      ],
      "language": "1041",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  }
}
